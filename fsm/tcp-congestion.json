{
  "protocol": "tcp-congestion",
  "family": "tcp",
  "title": "TCP · controle de congestionamento",
  "source": "Kurose & Ross, figura 3.51 (TCP Reno)",
  "summary": "Partida lenta, prevenção de congestionamento (AIMD) e recuperação rápida. A retransmissão rápida após 3 ACKs duplicados é uma transição desta máquina.",
  "component": true,
  "machines": [
    {
      "name": "congestion",
      "title": "Congestionamento",
      "initial": "SLOW_START",
      "init": [
        "cwnd.set(1MSS)",
        "dupacks.reset"
      ],
      "width": 900,
      "height": 600,
      "states": [
        {
          "id": "SLOW_START",
          "label": "SLOW START",
          "x": 190,
          "y": 150
        },
        {
          "id": "CONGESTION_AVOIDANCE",
          "label": "CONGESTION AVOIDANCE",
          "x": 710,
          "y": 150
        },
        {
          "id": "FAST_RECOVERY",
          "label": "FAST RECOVERY",
          "x": 450,
          "y": 440
        }
      ],
      "transitions": [
        {
          "from": "SLOW_START",
          "event": "ack.dup",
          "guard": "third_dup_ack && fast_retransmit",
          "actions": [
            "dupacks.inc",
            "ssthresh.set(cwnd/2)",
            "cwnd.set(ssthresh+3MSS)",
            "retransmit(fast)"
          ],
          "to": "FAST_RECOVERY",
          "bend": -0.12,
          "label": {
            "event": "dupACKcount == 3",
            "action": "ssthresh = cwnd/2\ncwnd = ssthresh + 3·MSS\nretransmite segmento perdido"
          },
          "labelAt": {
            "x": 236,
            "y": 318
          }
        },
        {
          "from": "SLOW_START",
          "event": "ack.dup",
          "actions": [
            "dupacks.inc"
          ],
          "to": "SLOW_START",
          "loop": "top",
          "label": {
            "event": "ACK duplicado",
            "action": "dupACKcount++"
          }
        },
        {
          "from": "SLOW_START",
          "event": "ack.new",
          "guard": "reaches_ssthresh",
          "actions": [
            "cwnd.add(MSS)",
            "dupacks.reset",
            "transmit(new)"
          ],
          "to": "CONGESTION_AVOIDANCE",
          "bend": -0.1,
          "label": {
            "event": "cwnd ≥ ssthresh",
            "action": "Λ"
          },
          "labelAt": {
            "x": 450,
            "y": 104
          }
        },
        {
          "from": "SLOW_START",
          "event": "ack.new",
          "actions": [
            "cwnd.add(MSS)",
            "dupacks.reset",
            "transmit(new)"
          ],
          "to": "SLOW_START",
          "loop": "left",
          "label": {
            "event": "novo ACK",
            "action": "cwnd = cwnd + MSS\ndupACKcount = 0\ntransmite novos segmentos"
          }
        },
        {
          "from": "SLOW_START",
          "event": "timeout",
          "actions": [
            "ssthresh.set(cwnd/2)",
            "cwnd.set(1MSS)",
            "dupacks.reset"
          ],
          "to": "SLOW_START",
          "loop": "bottom",
          "label": {
            "event": "timeout",
            "action": "ssthresh = cwnd/2\ncwnd = 1 MSS\ndupACKcount = 0"
          }
        },
        {
          "from": "CONGESTION_AVOIDANCE",
          "event": "ack.new",
          "actions": [
            "cwnd.add(MSS*MSS/cwnd)",
            "dupacks.reset",
            "transmit(new)"
          ],
          "to": "CONGESTION_AVOIDANCE",
          "loop": "right",
          "label": {
            "event": "novo ACK",
            "action": "cwnd = cwnd + MSS·(MSS/cwnd)\ndupACKcount = 0\ntransmite novos segmentos"
          }
        },
        {
          "from": "CONGESTION_AVOIDANCE",
          "event": "ack.dup",
          "guard": "third_dup_ack && fast_retransmit",
          "actions": [
            "dupacks.inc",
            "ssthresh.set(cwnd/2)",
            "cwnd.set(ssthresh+3MSS)",
            "retransmit(fast)"
          ],
          "to": "FAST_RECOVERY",
          "bend": 0.12,
          "label": {
            "event": "dupACKcount == 3",
            "action": "ssthresh = cwnd/2\ncwnd = ssthresh + 3·MSS\nretransmite segmento perdido"
          },
          "labelAt": {
            "x": 664,
            "y": 318
          }
        },
        {
          "from": "CONGESTION_AVOIDANCE",
          "event": "ack.dup",
          "actions": [
            "dupacks.inc"
          ],
          "to": "CONGESTION_AVOIDANCE",
          "loop": "top",
          "label": {
            "event": "ACK duplicado",
            "action": "dupACKcount++"
          }
        },
        {
          "from": "CONGESTION_AVOIDANCE",
          "event": "timeout",
          "actions": [
            "ssthresh.set(cwnd/2)",
            "cwnd.set(1MSS)",
            "dupacks.reset"
          ],
          "to": "SLOW_START",
          "bend": -0.1,
          "label": {
            "event": "timeout",
            "action": "ssthresh = cwnd/2\ncwnd = 1 MSS\ndupACKcount = 0"
          },
          "labelAt": {
            "x": 450,
            "y": 206
          }
        },
        {
          "from": "FAST_RECOVERY",
          "event": "ack.dup",
          "actions": [
            "cwnd.add(MSS)",
            "transmit(new)"
          ],
          "to": "FAST_RECOVERY",
          "loop": "bottom",
          "label": {
            "event": "ACK duplicado",
            "action": "cwnd = cwnd + MSS\ntransmite novos segmentos"
          }
        },
        {
          "from": "FAST_RECOVERY",
          "event": "ack.new",
          "actions": [
            "cwnd.set(ssthresh)",
            "dupacks.reset",
            "transmit(new)"
          ],
          "to": "CONGESTION_AVOIDANCE",
          "bend": 0.12,
          "label": {
            "event": "novo ACK",
            "action": "cwnd = ssthresh\ndupACKcount = 0"
          },
          "labelAt": {
            "x": 704,
            "y": 488
          }
        },
        {
          "from": "FAST_RECOVERY",
          "event": "timeout",
          "actions": [
            "ssthresh.set(cwnd/2)",
            "cwnd.set(1MSS)",
            "dupacks.reset"
          ],
          "to": "SLOW_START",
          "bend": -0.12,
          "label": {
            "event": "timeout",
            "action": "ssthresh = cwnd/2\ncwnd = 1 MSS\ndupACKcount = 0"
          },
          "labelAt": {
            "x": 196,
            "y": 488
          }
        }
      ]
    }
  ]
}
