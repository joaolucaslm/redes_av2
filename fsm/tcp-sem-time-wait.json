            "rcv.FIN",
            "rcv.data"
          ],
          "actions": [
            "send(ACK)"
          ],
          "to": "LAST_ACK",
          "quiet": true,
          "label": {
            "event": "rcv FIN repetido",
            "action": "snd ACK"
          }
        },
        {
          "from": "LAST_ACK",
          "event": "rcv.RST",
          "actions": [
            "app.notify(reset)",
            "tcb.release"
          ],
          "to": "CLOSED",
          "quiet": true,
          "label": {
            "event": "rcv RST",
            "action": "fechamento abortado"
          }
        }
      ]
    }
  ]
}
