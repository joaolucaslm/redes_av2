    { "count": { "kind": "transition", "host": "B", "from": "CLOSED", "event": "rcv.SYN", "action": "send(RST)" }, "eq": 1 },
    { "visits": { "host": "A", "states": ["CLOSED", "SYN_SENT", "CLOSED"], "exact": true } },
    { "title": "a aplicação de A é avisada da recusa", "count": { "kind": "app", "host": "A", "event": "refused" }, "eq": 1 },
    { "title": "nenhuma retransmissão depois do RST", "metric": { "name": "retransmissions", "eq": 0 } }
